# Snapt API server — copy to .env and fill in.
# Local values come from `supabase start` output (supabase status).

PORT=4000
HOST=127.0.0.1

SUPABASE_URL=http://127.0.0.1:54321
# Service role key — server only. NEVER put this in the Expo app.
SUPABASE_SERVICE_ROLE_KEY=

# Optional until Stripe accounts exist (Phase 7 cutover). Server boots
# without these; payment endpoints return 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stopgap guard for admin actions (creator approval) until the Admin Portal
# exists (Phase 5). Leave unset to disable admin endpoints.
ADMIN_API_TOKEN=
