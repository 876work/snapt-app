# Snapt API server — copy to .env and fill in.
# Local values come from `supabase start` output (supabase status).

PORT=4000
HOST=127.0.0.1

SUPABASE_URL=http://127.0.0.1:54321
# Service role key — server only. NEVER put this in the Expo app.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe TEST keys (sk_test_...) enable real test-mode charges/refunds now;
# live keys land at Phase 7. Unset = simulated ledger. NO Connect — creator
# payouts are fulfilled manually from the admin queue.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stopgap guard for admin actions (creator approval) until the Admin Portal
# exists (Phase 5). Leave unset to disable admin endpoints.
ADMIN_API_TOKEN=

# Email via Resend — Snapt's only out-of-app channel (no SMS anywhere).
# Unset = emails are simulated (logged) in local dev.
RESEND_API_KEY=
RESEND_FROM=


# On-call staff for real-time SOS escalation (comma-separated emails).
ONCALL_EMAILS=
SUPABASE_ANON_KEY=
