# Expo app env — copy to .env. Without these the app runs in mock-auth mode
# (fully tappable, no backend). With them, auth goes through Supabase.
# Local values: run `supabase start`, then `supabase status` for the anon key.
# Production values live in .env.production (committed — all public by design)
# and are picked up automatically by release builds.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# API server (lib/api.ts). Local: http://127.0.0.1:4000. Unset = mock booking flow.
EXPO_PUBLIC_API_URL=

# Stripe publishable key (pk_test_/pk_live_). Safe to expose to the client.
# Reserved for the Phase 7 in-app card entry / payment sheet flow.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Sign-In (public client IDs; the web client secret is Supabase-only)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google Maps native SDK keys (BUILD-time, baked into binaries).
# Real values live in EAS environment variables + local .env only — never in
# the repo, never in .env.production. Server geocoding uses a separate
# IP-restricted key on Render (GOOGLE_MAPS_SERVER_KEY in server/.env.example).
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_ANDROID_KEY=
