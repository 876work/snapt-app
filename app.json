{
  "expo": {
    "name": "Snapt",
    "slug": "snapt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "snapt",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.snaptcarib.snapt",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:links.snaptcarib.app"
      ]
    },
    "android": {
      "package": "app.snaptcarib.snapt",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFB800",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "links.snaptcarib.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Snapt uses your photo library so you can upload footage for editing and add photos to your creator portfolio.",
          "cameraPermission": "Snapt uses the camera to capture photos and videos during sessions."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Snapt saves your delivered photos and videos to your photo library.",
          "photosPermission": "Snapt uses your photo library to save and manage your delivered content."
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Snapt uses your location to centre the map and help you drop your meeting-point pin in the right place. When In Use only — never in the background.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.570146606269-j3c88mhk91ai60bsvsk7lchecutdei80"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Snapt uses Face ID to unlock the app and your payout details. You can always fall back to your device passcode."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a9fec14-9f94-4cf7-9981-9429174eefd3"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2a9fec14-9f94-4cf7-9981-9429174eefd3"
    },
    "locales": {
      "en": "./locales/store/en.json"
    }
  }
}
