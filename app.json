{
  "expo": {
    "name": "Snapt",
    "slug": "snapt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "snapt",
    "splash": {
      "image": "./assets/design/snapt-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.snaptcarib.snapt",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.snaptcarib.snapt",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFB800",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Snapt uses your photo library so you can upload footage for editing and add photos to your creator portfolio.",
          "cameraPermission": "Snapt uses the camera to capture photos and videos during sessions."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Snapt saves your delivered photos and videos to your photo library.",
          "photosPermission": "Snapt uses your photo library to save and manage your delivered content."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a9fec14-9f94-4cf7-9981-9429174eefd3"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2a9fec14-9f94-4cf7-9981-9429174eefd3"
    }
  }
}
