{
  "expo": {
    "name": "Snapt",
    "slug": "snapt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "snapt",
    "splash": {
      "image": "./assets/design/snapt-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.snaptcarib.snapt"
    },
    "android": {
      "package": "app.snaptcarib.snapt",
      "adaptiveIcon": {
        "backgroundColor": "#FFB800",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2a9fec14-9f94-4cf7-9981-9429174eefd3"
      }
    }
  }
}
